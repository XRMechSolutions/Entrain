  "license": "GPL-3.0-or-later",
  "author": "XRMech",
  "homepage": "https://github.com/XRMech/entrain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRMech/entrain.git"
  },
  "bugs": {
    "url": "https://github.com/XRMech/entrain/issues"
  },
  "keywords": [
    "binaural-beats",
    "isochronic-tones",
    "brainwave-entrainment",
    "meditation",
    "sleep",
    "focus",
    "pwa",
    "web-audio",
    "audioworklet",
    "svelte"
  ],
  "engines": {
